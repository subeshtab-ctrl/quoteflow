# QuoteFlow SaaS Environment Configuration

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Supabase Project Credentials (Found in Supabase Dashboard -> Settings -> API)
# Project: https://supabase.com/dashboard/project/qykxxxayympfhbymmnnw/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://qykxxxayympfhbymmnnw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Resend Email Configuration (https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
# Set your verified domain sender once verified in resend.com/domains:
EMAIL_FROM=QuoteFlow <quotes@blendandbold.com>

# Razorpay Subscriptions & Standard Checkout Configuration (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
RAZORPAY_MODE=test
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
PAYMENT_GRACE_PERIOD_DAYS=7

# NOWPayments Crypto Gateway Configuration (https://nowpayments.io)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret_here
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# Meta WhatsApp Business Platform & Cloud API Configuration (https://developers.facebook.com)
NEXT_PUBLIC_META_APP_ID=your_meta_app_id_here
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
NEXT_PUBLIC_META_CONFIG_ID=your_meta_embedded_signup_config_id_here
META_CONFIG_ID=your_meta_embedded_signup_config_id_here
META_WEBHOOK_VERIFY_TOKEN=quoteflow_meta_webhook_verify_token
META_GRAPH_API_VERSION=v21.0
ENCRYPTION_SECRET=your_32_byte_aes_encryption_secret_here

# Strict Admin & Developer Security Configuration
ADMIN_EMAIL=admin@example.com
DEV_ADMIN_JWT_SECRET=your_dev_admin_jwt_secret_here


